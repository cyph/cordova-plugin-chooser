{
	"name": "cordova-plugin-chooser",
	"version": "2.0.0-rc.2",
	"description": "File chooser for Cordova and Capacitor",
	"homepage": "https://github.com/cyph/cordova-plugin-chooser#readme",
	"main": "www/chooser.js",
	"types": "index.d.ts",
	"files": [
		"plugin.xml",
		"www/",
		"src/",
		"index.d.ts",
		"README.md",
		"CHANGELOG.md",
		"CONTRIBUTING.md",
		"docs/",
		"LICENSE",
		"NOTICE",
		"capacitor/",
		"Package.swift",
		"CordovaPluginChooser.podspec"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cyph/cordova-plugin-chooser.git"
	},
	"keywords": [
		"file",
		"chooser",
		"picker",
		"file-chooser",
		"android",
		"ios",
		"browser",
		"multiple-files",
		"typescript"
	],
	"author": "Cyph, Inc. <cordova-plugin-chooser@cyph.com> (https://github.com/cyph)",
	"license": "Apache-2.0",
	"bugs": {
		"url": "https://github.com/cyph/cordova-plugin-chooser/issues"
	},
	"cordova": {
		"id": "cordova-plugin-chooser",
		"platforms": [
			"android",
			"ios",
			"browser"
		]
	},
	"scripts": {
		"build": "node scripts/build-runtime.mts",
		"check:runtime": "node scripts/build-runtime.mts --check",
		"test": "node --test tests/js/*.test.js",
		"test:types": "node scripts/check-types.mjs"
	},
	"devDependencies": {
		"@capacitor/android": "8.5.3",
		"@capacitor/cli": "8.5.3",
		"@capacitor/core": "8.5.3",
		"@types/node": "26.6.5",
		"cordova": "^13.0.0",
		"cordova-android14": "npm:cordova-android@14.x",
		"cordova-android15": "npm:cordova-android@15.x",
		"cordova-browser": "^7.0.0",
		"cordova-ios7": "npm:cordova-ios@7.x",
		"cordova-ios8": "npm:cordova-ios@8.x",
		"npm": "12.2.1",
		"typescript": "7.0.2",
		"typescript-minimum": "npm:typescript@5.7.x"
	},
	"packageManager": "pnpm@12.14.0",
	"exports": {
		".": {
			"types": "./index.d.ts",
			"default": "./www/chooser.js"
		},
		"./capacitor": {
			"types": "./capacitor/index.d.ts",
			"default": "./capacitor/index.js"
		},
		"./*": "./*"
	},
	"capacitor": {
		"android": {
			"src": "capacitor/android"
		},
		"ios": {
			"src": "capacitor/ios"
		}
	},
	"peerDependencies": {
		"@capacitor/core": "^8.0.0"
	},
	"peerDependenciesMeta": {
		"@capacitor/core": {
			"optional": true
		}
	}
}

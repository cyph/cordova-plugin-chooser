{
	"name": "cordova-plugin-chooser",
	"version": "2.0.0-rc.1",
	"description": "Cordova file chooser plugin",
	"homepage": "https://github.com/cyph/cordova-plugin-chooser#readme",
	"main": "www/chooser.js",
	"types": "index.d.ts",
	"files": [
		"plugin.xml",
		"www/",
		"src/",
		"index.d.ts",
		"README.md",
		"CHANGELOG.md",
		"CONTRIBUTING.md",
		"docs/",
		"LICENSE",
		"NOTICE"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cyph/cordova-plugin-chooser.git"
	},
	"keywords": [
		"file",
		"chooser",
		"picker",
		"file-chooser",
		"android",
		"ios",
		"browser",
		"multiple-files",
		"typescript"
	],
	"author": "Cyph, Inc. <cordova-plugin-chooser@cyph.com> (https://github.com/cyph)",
	"license": "Apache-2.0",
	"bugs": {
		"url": "https://github.com/cyph/cordova-plugin-chooser/issues"
	},
	"cordova": {
		"id": "cordova-plugin-chooser",
		"platforms": [
			"android",
			"ios",
			"browser"
		]
	},
	"scripts": {
		"test": "node --test tests/js/*.test.js",
		"test:types": "tsc --noEmit --strict --module node16 --moduleResolution node16 --lib ES2020,DOM tests/types/contracts.ts"
	},
	"devDependencies": {
		"cordova": "^13.0.0",
		"cordova-android14": "npm:cordova-android@>=14.0.0 <15",
		"cordova-android15": "npm:cordova-android@>=15.0.0 <16",
		"cordova-browser": "^7.0.0",
		"cordova-ios7": "npm:cordova-ios@>=7.0.0 <8",
		"cordova-ios8": "npm:cordova-ios@>=8.0.0 <9",
		"typescript": "7.0.2"
	},
	"packageManager": "pnpm@11.25.0"
}

{
  "compilerOptions": {
    "target": "ES2019",
    "newLine": "lf",
    "module": "Node16",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "typescript",
    "noEmitOnError": true
  },
  "include": ["typescript/**/*.ts", "typescript/**/*.mts"]
}

<?xml version="1.0" encoding="utf-8"?>
<plugin
	xmlns="http://www.phonegap.com/ns/plugins/1.0"
	xmlns:android="http://schemas.android.com/apk/res/android"
	id="cordova-plugin-chooser"
	version="1.3.2"
>
	<name>Chooser</name>
	<author>Cyph, Inc.</author>
	<license>Apache-2.0</license>

	<engines>
		<engine name="cordova-android" version=">=14.0.0" />
		<engine name="cordova-ios" version=">=7.0.0" />
	</engines>

	<js-module src="www/chooser.js" name="Chooser">
		<clobbers target="chooser" />
	</js-module>

	<platform name="android">
		<source-file src="src/android/Chooser.java" target-dir="src/com/cyph/cordova" />
		<source-file src="src/android/ChooserFiles.java" target-dir="src/com/cyph/cordova" />
		<source-file src="src/android/ChooserBudget.java" target-dir="src/com/cyph/cordova" />
		<source-file src="src/android/ChooserTransaction.java" target-dir="src/com/cyph/cordova" />
		<source-file src="src/android/ChooserRequest.java" target-dir="src/com/cyph/cordova" />
		<source-file src="src/android/ChooserError.java" target-dir="src/com/cyph/cordova" />

		<config-file target="config.xml" parent="/*">
			<feature name="Chooser">
				<param name="android-package" value="com.cyph.cordova.Chooser" />
			</feature>
		</config-file>
	</platform>

	<platform name="ios">
		<source-file src="src/ios/Chooser.swift" />
		<source-file src="src/ios/ChooserFiles.swift" />
		<source-file src="src/ios/ChooserBudget.swift" />
		<source-file src="src/ios/ChooserTransaction.swift" />
		<source-file src="src/ios/ChooserRequest.swift" />
		<source-file src="src/ios/ChooserError.swift" />

		<config-file target="config.xml" parent="/*">
			<feature name="Chooser">
				<param name="ios-package" value="Chooser" />
			</feature>
		</config-file>
	</platform>

	<platform name="browser">
		<js-module src="src/browser/ChooserProxy.js" name="ChooserProxy">
			<runs/>
		</js-module>
	</platform>
</plugin>
